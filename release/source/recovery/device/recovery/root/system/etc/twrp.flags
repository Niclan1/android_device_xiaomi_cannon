# Super partitions and the boot chain are written by the ROM package, not wiped from the GUI.
/system_root ext4 /dev/block/mapper/system      flags=display="System";canbewiped=0;wipeingui=0;wipeduringfactoryreset=0;backup=0
/vendor      ext4 /dev/block/mapper/vendor      flags=display="Vendor";canbewiped=0;wipeingui=0;wipeduringfactoryreset=0;backup=0
/product     ext4 /dev/block/mapper/product     flags=display="Product";canbewiped=0;wipeingui=0;wipeduringfactoryreset=0;backup=0
/system_ext  ext4 /dev/block/mapper/system_ext  flags=display="System_ext";canbewiped=0;wipeingui=0;wipeduringfactoryreset=0;backup=0
/cache       ext4 /dev/block/by-name/cache      flags=canbewiped=0;wipeingui=0;wipeduringfactoryreset=0;backup=0
/boot        emmc /dev/block/by-name/boot       flags=display="Boot";backup=1;flashimg=0
/recovery    emmc /dev/block/by-name/recovery   flags=display="Recovery";backup=1;flashimg=0
/dtbo        emmc /dev/block/by-name/dtbo       flags=display="DTBO";backup=1;flashimg=0
/misc        emmc /dev/block/by-name/misc       flags=display="Misc";canbewiped=0;wipeingui=0;backup=0