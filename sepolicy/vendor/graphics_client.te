# libdrm/Mesa (EGL, Vulkan) and the minigbm mapper run in every process that
# draws. They identify the GPU through /sys/devices/platform/13000000.gpu/uevent
# (sysfs_gpu) and read vendor.minigbm.* / vendor.mesa.* debug properties.
r_dir_file({
    appdomain
    -isolated_app_all
    bootanim
    cameraserver
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    surfaceflinger
    system_server
}, sysfs_gpu)

get_prop(domain, vendor_graphics_debug_prop)
