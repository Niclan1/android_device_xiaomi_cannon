+                                    if (e.getMessage() != null
+                                            && e.getMessage()
+                                                    .contains(
+                                                            "Cannot set application restrictions on"
+                                                                    + " more than")) {
+                                        failureCount.incrementAndGet();
+                                        done = true;
+                                    } else {
