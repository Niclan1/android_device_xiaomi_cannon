@@ -143,35 +131,8 @@ void ALooperRoster::dump(int fd, const Vector<String16>& args) {
             s.append(looper->getName());
             sp<AHandler> handler = info.mHandler.promote();
             if (handler != NULL) {
-                bool deliveringMessages;
