+  void TransmitSniffSubrating(bool status_event, hci::ErrorCode status) {
+    using ReplyCallback = common::ContextualOnceCallback<void(hci::CommandStatusOrCompleteView)>;
+    struct Result {
+      bool status_event;
+      hci::ErrorCode status;
+    };
+    struct Context {
+      const BT_HDR* command;
+      std::promise<Result> result;
+    };
+    auto bytes = hci::SniffSubratingBuilder::Create(0x123, 0x456, 0x789, 0xabc)->SerializeToBytes();
+    auto* command = static_cast<BT_HDR*>(osi_calloc(sizeof(BT_HDR) + bytes.size()));
+    ASSERT_NE(nullptr, command);
+    command->len = bytes.size();
+    std::copy(bytes.begin(), bytes.end(), command->data);
+    Context context{.command = command};
+    auto result = context.result.get_future();
+
+    EXPECT_CALL(*gd_test::mock_hci_layer_, EnqueueCommand(_, A<ReplyCallback>()))
+            .WillOnce([&](std::unique_ptr<hci::CommandBuilder> command_packet,
+                          ReplyCallback callback) {
+              EXPECT_EQ(bytes, command_packet->SerializeToBytes());
+              auto reply = status_event
+                                   ? hci::CommandStatusBuilder::Create(
+                                             status, 1, hci::OpCode::SNIFF_SUBRATING,
+                                             std::make_unique<packet::RawBuilder>())
+                                             ->SerializeToBytes()
+                                   : hci::SniffSubratingCompleteBuilder::Create(1, status, 0x123)
+                                             ->SerializeToBytes();
+              auto storage = std::make_shared<std::vector<uint8_t>>(std::move(reply));
+              auto event = hci::EventView::Create(hci::PacketView<hci::kLittleEndian>(storage));
+              ASSERT_TRUE(event.IsValid());
+              if (status_event) {
+                auto view = hci::CommandStatusView::Create(event);
+                ASSERT_TRUE(view.IsValid());
+                callback(view);
+              } else {
+                auto view = hci::CommandCompleteView::Create(event);
+                ASSERT_TRUE(view.IsValid());
+                callback(view);
+              }
+            });
+
+    shim::hci_layer_get_interface()->transmit_command(
+            command,
+            [](hci::CommandCompleteView view, void* opaque) {
+              auto reply = hci::SniffSubratingCompleteView::Create(view);
+              ASSERT_TRUE(reply.IsValid());
+              static_cast<Context*>(opaque)->result.set_value({false, reply.GetStatus()});
+            },
+            [](uint8_t status, BT_HDR* command, void* opaque) {
+              auto* context = static_cast<Context*>(opaque);
+              EXPECT_EQ(context->command, command);
+              osi_free(command);
+              context->result.set_value({true, static_cast<hci::ErrorCode>(status)});
+            },
+            &context);
+
+    ASSERT_EQ(std::future_status::ready, result.wait_for(std::chrono::seconds(1)));
+    auto reply = result.get();
+    EXPECT_EQ(status_event, reply.status_event);
+    EXPECT_EQ(status, reply.status);
+    std::promise<void> idle;
+    auto idle_future = idle.get_future();
+    handler_->Call([](std::promise<void> idle) { idle.set_value(); }, std::move(idle));
+    ASSERT_EQ(std::future_status::ready, idle_future.wait_for(std::chrono::seconds(1)));
+  }
+
+private:
+  ::test::fake::FakeOsi osi_;
+  std::unique_ptr<os::Thread> thread_;
+  std::unique_ptr<os::Handler> handler_;
+};
