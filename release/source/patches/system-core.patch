 void InitKernelLogging(char** argv) {
     SetFatalRebootTarget();
-    android::base::InitLogging(argv, &android::base::KernelLogger, InitAborter);
+    std::string cmdline;
+    android::base::ReadFileToString("/proc/cmdline", &cmdline);
+    if (cmdline.find("androidboot.cannong_init_log=1") != std::string::npos) {
+        android::base::InitLogging(argv,
+                android::base::TeeLogger(&android::base::KernelLogger, &CannongCacheLogger),
+                InitAborter);
+        if (argv && argv[1] && !strcmp(argv[1], "second_stage")) CannongStartLogcatCapture();
+    } else {
+        android::base::InitLogging(argv, &android::base::KernelLogger, InitAborter);
+    }
 }
 
