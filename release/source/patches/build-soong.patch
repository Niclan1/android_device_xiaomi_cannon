+type pinnedGraphManifest struct {
+	Version    int               `json:"version"`
+	Product    string            `json:"product"`
+	Variant    string            `json:"variant"`
+	KatiSuffix string            `json:"kati_suffix"`
+	Files      map[string]string `json:"files"`
+}
+
+func checkPinnedGraphFile(root, name, digest string) error {
+	if filepath.IsAbs(name) || filepath.Clean(name) != name || name == "." ||
+		name == ".." || strings.HasPrefix(name, ".."+string(filepath.Separator)) {
+		return fmt.Errorf("invalid cache path %q", name)
+	}
+	path := filepath.Join(root, name)
+	info, err := os.Lstat(path)
+	if os.IsNotExist(err) && digest == "" {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if digest == "" || !info.Mode().IsRegular() {
+		return fmt.Errorf("cache file presence/type changed: %s", name)
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	hash := sha256.New()
+	_, readErr := io.Copy(hash, file)
+	closeErr := file.Close()
+	if readErr != nil {
+		return readErr
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if fmt.Sprintf("%x", hash.Sum(nil)) != digest {
+		return fmt.Errorf("cache digest changed: %s", name)
+	}
+	return nil
+}
+
+func validatePinnedGraph(config Config) error {
+	parts := strings.SplitN(config.validatedGraph, ":", 2)
+	if len(parts) != 2 || len(parts[0]) != 64 || !filepath.IsAbs(parts[1]) {
+		return fmt.Errorf("expected SHA256:absolute-manifest-path")
+	}
+	file, err := os.Open(parts[1])
+	if err != nil {
+		return err
+	}
+	data, readErr := io.ReadAll(io.LimitReader(file, 1024*1024+1))
+	closeErr := file.Close()
+	if readErr != nil {
+		return readErr
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if len(data) > 1024*1024 || fmt.Sprintf("%x", sha256.Sum256(data)) != parts[0] {
+		return fmt.Errorf("manifest size/digest mismatch")
+	}
+	var manifest pinnedGraphManifest
+	if err := json.Unmarshal(data, &manifest); err != nil {
+		return err
+	}
+	product, err := config.TargetProductOrErr()
+	if err != nil {
+		return err
+	}
+	if manifest.Version != 1 || manifest.Product != product ||
+		manifest.Variant != config.TargetBuildVariant() || manifest.KatiSuffix != config.KatiSuffix() {
+		return fmt.Errorf("product/variant/Kati suffix mismatch")
+	}
+	for _, path := range []string{
+		config.CombinedNinjaFile(), config.KatiBuildNinjaFile(), config.KatiPackageNinjaFile(),
+		config.KatiEnvFile(), config.LastKatiSuffixFile(),
+		filepath.Join(config.SoongOutDir(), "build."+product+".ninja"),
+		filepath.Join(config.SoongOutDir(), "soong."+product+".variables"),
+		filepath.Join(config.SoongOutDir(), "soong."+product+".extra.variables"),
+		filepath.Join(config.FileListDir(), "Android.bp.list"),
+		filepath.Join(config.FileListDir(), "Android.mk.list"),
+		filepath.Join(config.FileListDir(), "CleanSpec.mk.list"),
+	} {
+		name, err := filepath.Rel(config.OutDir(), path)
+		if err != nil {
+			return err
+		}
+		if manifest.Files[name] == "" {
+			return fmt.Errorf("required cache file not pinned: %s", name)
+		}
+	}
+	for name, digest := range manifest.Files {
+		if err := checkPinnedGraphFile(config.OutDir(), name, digest); err != nil {
+			return err
+		}
+	}
+	return nil
+}
