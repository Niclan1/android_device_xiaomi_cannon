+class MetadataScratchTest(test_utils.ReleaseToolsTestCase):
+  def make_package(self):
+    source = common.MakeTempFile(suffix=".zip")
+    with zipfile.ZipFile(source, "w") as archive:
+      archive.writestr("boot.img", b"boot payload")
+    return source, common.MakeTempFile(suffix=".zip")
+
+  def finalize(self, source, output, **kwargs):
+    ota_utils.FinalizeMetadata(
+        ota_utils.ota_metadata_pb2.OtaMetadata(), source, output,
+        needed_property_files=[NonAbOtaPropertyFiles()], **kwargs)
+    with zipfile.ZipFile(output) as archive:
+      self.assertEqual(b"boot payload", archive.read("boot.img"))
+
+  def test_owned_input_released_before_final_signing(self):
+    source, output = self.make_package()
+
+    def sign(input_file, output_file, *args):
+      self.assertEqual(input_file == source, os.path.exists(source))
+      shutil.copyfile(input_file, output_file)
+
+    with mock.patch.object(ota_utils, "SignOutput", side_effect=sign) as signer:
+      self.finalize(source, output, package_key="testkey", input_is_temporary=True)
+    self.assertEqual(2, signer.call_count)
+    self.assertFalse(os.path.exists(source))
+
+  def test_default_preserves_caller_input(self):
+    source, output = self.make_package()
+    with mock.patch.object(ota_utils, "SignOutput", side_effect=lambda a, b, *args: shutil.copyfile(a, b)):
+      self.finalize(source, output, package_key="testkey")
+    self.assertTrue(os.path.exists(source))
+
+  def test_failed_preliminary_signing_preserves_input(self):
+    source, output = self.make_package()
+    with mock.patch.object(ota_utils, "SignOutput", side_effect=RuntimeError("signing failed")):
+      with self.assertRaisesRegex(RuntimeError, "signing failed"):
+        self.finalize(source, output, package_key="testkey", input_is_temporary=True)
+    self.assertTrue(os.path.exists(source))
+
+  def test_unsigned_input_is_not_released(self):
+    source, output = self.make_package()
+    self.finalize(source, output, input_is_temporary=True)
+    self.assertTrue(os.path.exists(source))
+
+  def test_failed_property_finalization_preserves_input(self):
+    source, output = self.make_package()
+    with mock.patch.object(ota_utils, "SignOutput", side_effect=lambda a, b, *args: shutil.copyfile(a, b)), \
+        mock.patch.object(NonAbOtaPropertyFiles, "Finalize", side_effect=RuntimeError("metadata failed")):
+      with self.assertRaisesRegex(RuntimeError, "metadata failed"):
+        self.finalize(source, output, package_key="testkey", input_is_temporary=True)
+    self.assertTrue(os.path.exists(source))
