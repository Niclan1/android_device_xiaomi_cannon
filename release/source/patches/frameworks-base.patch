diff --git a/core/java/android/app/admin/BundlePolicyTypeVerifier.java b/core/java/android/app/admin/BundlePolicyTypeVerifier.java
new file mode 100644
index 0000000000000000000000000000000000000000..d1014de019d150df32f515f4f4743460a6a5d428
--- /dev/null
+++ b/core/java/android/app/admin/BundlePolicyTypeVerifier.java
@@ -0,0 +1,83 @@
