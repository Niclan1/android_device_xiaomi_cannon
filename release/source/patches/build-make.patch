+class FullOtaScratchTest(test_utils.ReleaseToolsTestCase):
+  def make_block_diff(self, source=None):
+    block_diff = common.BlockDifference.__new__(common.BlockDifference)
+    block_diff.src = source
+    block_diff.path = os.path.join(common.MakeTempDir(), "system")
+    block_diff.partition = "system"
+    block_diff.device = "/dev/block/system"
+    for suffix in (".new.dat", ".transfer.list", ".patch.dat"):
+      with open(block_diff.path + suffix, "wb") as stream:
+        stream.write(b"partition payload")
+    return block_diff
+
+  def compress(self, command):
+    with open(command[2].removeprefix("--output="), "wb") as stream:
+      stream.write(b"compressed partition payload")
+
+  def script(self):
+    script = mock.Mock()
+    script.WordWrap.side_effect = lambda value: value
+    return script
+
+  def test_release_preserves_committed_payload_and_control_files(self):
+    block_diff = self.make_block_diff()
+    archive = common.MakeTempFile(suffix=".zip")
+    with zipfile.ZipFile(archive, "w") as output, \
+        mock.patch.object(common, "RunAndCheckOutput", side_effect=self.compress):
+      block_diff._WriteUpdate(self.script(), output)
+    self.assertFalse(os.path.exists(block_diff.path + ".new.dat"))
+    self.assertFalse(os.path.exists(block_diff.path + ".new.dat.br"))
+    self.assertTrue(os.path.exists(block_diff.path + ".transfer.list"))
+    self.assertTrue(os.path.exists(block_diff.path + ".patch.dat"))
+    with zipfile.ZipFile(archive) as output:
+      self.assertEqual(b"compressed partition payload", output.read("system.new.dat.br"))
+
+  def test_incremental_keeps_its_data(self):
+    block_diff = self.make_block_diff(source=object())
+    archive = common.MakeTempFile(suffix=".zip")
+    with zipfile.ZipFile(archive, "w") as output:
+      block_diff._WriteUpdate(self.script(), output)
+    self.assertTrue(os.path.exists(block_diff.path + ".new.dat"))
+
+  def test_failed_compression_retains_input(self):
+    block_diff = self.make_block_diff()
+    archive = common.MakeTempFile(suffix=".zip")
+    with zipfile.ZipFile(archive, "w") as output, \
+        mock.patch.object(common, "RunAndCheckOutput", side_effect=RuntimeError("compression failed")):
+      with self.assertRaisesRegex(RuntimeError, "compression failed"):
+        block_diff._WriteUpdate(self.script(), output)
+    self.assertTrue(os.path.exists(block_diff.path + ".new.dat"))
+
+  def test_failed_archive_write_retains_both_buffers(self):
+    block_diff = self.make_block_diff()
+    archive = common.MakeTempFile(suffix=".zip")
+    write = common.ZipWrite
+
+    def fail_payload(*args, **kwargs):
+      if args[2] == "system.new.dat.br":
+        raise RuntimeError("archive failed")
+      return write(*args, **kwargs)
+
+    with zipfile.ZipFile(archive, "w") as output, \
+        mock.patch.object(common, "RunAndCheckOutput", side_effect=self.compress), \
+        mock.patch.object(common, "ZipWrite", side_effect=fail_payload):
+      with self.assertRaisesRegex(RuntimeError, "archive failed"):
+        block_diff._WriteUpdate(self.script(), output)
+    self.assertTrue(os.path.exists(block_diff.path + ".new.dat"))
+    self.assertTrue(os.path.exists(block_diff.path + ".new.dat.br"))
+
+  def test_directory_archive_is_lossless_without_a_stored_copy(self):
+    directory = common.MakeTempDir()
+    payload = b"target-files block\n" * 100000
+    with open(os.path.join(directory, "boot.img"), "wb") as stream:
+      stream.write(payload)
+    common.OPTIONS.info_dict = {}
+    common.OPTIONS.extracted_input = None
+    common.OPTIONS.extra_script = None
+    common.OPTIONS.device_specific = ""
+
+    def consume(input_zip, output_file):
+      self.assertEqual(payload, input_zip.read("boot.img"))
+      self.assertIsNone(input_zip.testzip())
+      self.assertLess(os.path.getsize(input_zip.filename), len(payload) // 4)
+
+    with mock.patch.object(non_ab_ota, "WriteFullOTAPackage", side_effect=consume) as writer:
+      non_ab_ota.GenerateNonAbOtaPackage(directory, "unused-output")
+    writer.assert_called_once()
